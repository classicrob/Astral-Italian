{
  "version": 3,
  "configurePresets": [
    {
      "name": "macos-arm64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_BUILD_TYPE": "Debug",
        "PETARI_SANITIZERS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-arm64-release",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PETARI_SANITIZERS": "OFF"
      }
    },
    {
      "name": "macos-arm64-release-portable",
      "inherits": "macos-arm64-release",
      "binaryDir": "${sourceDir}/build/macos-arm64-release-portable",
      "cacheVariables": {
        "CMAKE_IGNORE_PREFIX_PATH": "/opt/homebrew;/usr/local",
        "CMAKE_DISABLE_FIND_PACKAGE_PkgConfig": "ON"
      }
    },
    {
      "name": "macos-arm64-headless",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-arm64-headless",
      "cacheVariables": {
        "PETARI_BUILD_HEADLESS": "ON",
        "PETARI_BUILD_GX_PROBE": "OFF",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0"
      }
    },
    {
      "name": "macos-arm64-headless-o2",
      "inherits": "macos-arm64-headless",
      "binaryDir": "${sourceDir}/build/macos-arm64-headless-o2",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-g -O2",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O2"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "jobs": 6
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "jobs": 6
    },
    {
      "name": "macos-arm64-release-portable",
      "configurePreset": "macos-arm64-release-portable",
      "jobs": 6
    },
    {
      "name": "macos-arm64-headless",
      "configurePreset": "macos-arm64-headless",
      "jobs": 6,
      "targets": [
        "petari_headless"
      ]
    },
    {
      "name": "macos-arm64-headless-o2",
      "configurePreset": "macos-arm64-headless-o2",
      "jobs": 6,
      "targets": [
        "petari_headless"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-headless",
      "configurePreset": "macos-arm64-headless",
      "filter": {
        "include": {
          "name": "^native_headless_"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-headless-o2",
      "configurePreset": "macos-arm64-headless-o2",
      "filter": {
        "include": {
          "name": "^native_headless_"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

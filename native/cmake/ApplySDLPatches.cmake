find_program(PETARI_GIT git REQUIRED)
file(GLOB _patches "${PATCH_DIR}/*.patch")
list(SORT _patches)
foreach(_patch IN LISTS _patches)
    file(SHA256 "${_patch}" _hash)
    get_filename_component(_name "${_patch}" NAME)
    set(_stamp "${SDL_SOURCE_DIR}/.petari-patches/${_name}.sha256")
    if(EXISTS "${_stamp}")
        file(READ "${_stamp}" _previous)
        if(_previous STREQUAL _hash)
            continue()
        endif()
        message(FATAL_ERROR "SDL patch ${_name} changed; remove the populated SDL source and reconfigure")
    endif()
    execute_process(COMMAND "${PETARI_GIT}" apply --check "${_patch}"
        WORKING_DIRECTORY "${SDL_SOURCE_DIR}" RESULT_VARIABLE _forward OUTPUT_QUIET ERROR_QUIET)
    if(_forward EQUAL 0)
        execute_process(COMMAND "${PETARI_GIT}" apply "${_patch}"
            WORKING_DIRECTORY "${SDL_SOURCE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${PETARI_GIT}" apply --reverse --check "${_patch}"
            WORKING_DIRECTORY "${SDL_SOURCE_DIR}" RESULT_VARIABLE _reverse OUTPUT_QUIET ERROR_QUIET)
        if(NOT _reverse EQUAL 0)
            message(FATAL_ERROR "SDL patch ${_name} does not apply cleanly")
        endif()
    endif()
    file(MAKE_DIRECTORY "${SDL_SOURCE_DIR}/.petari-patches")
    file(WRITE "${_stamp}" "${_hash}")
endforeach()

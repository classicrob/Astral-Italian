include_guard(GLOBAL)
include(FetchContent)

function(petari_configure_graphics_dependencies)
    # Aurora's auto provider otherwise changes when a system SDL is installed.
    set(AURORA_SDL3_PROVIDER vendor CACHE STRING "Pinned SDL source provider" FORCE)
    set(AURORA_SDL3_LINKAGE static CACHE STRING "Pinned SDL linkage" FORCE)
endfunction()

function(petari_link_audio_frameworks target)
    if(APPLE)
        find_library(PETARI_COREAUDIO_FRAMEWORK CoreAudio REQUIRED)
        target_link_libraries("${target}" PRIVATE "${PETARI_COREAUDIO_FRAMEWORK}")
    endif()
endfunction()

function(petari_record_graphics_dependencies output)
    file(WRITE "${output}" "")
    foreach(name aurora dawn_prebuilt imgui SDL tracy)
        FetchContent_GetProperties("${name}" SOURCE_DIR actual)
        if(NOT actual OR NOT IS_DIRECTORY "${actual}")
            message(FATAL_ERROR "Pinned ${name} source was not populated")
        endif()
        string(TOUPPER "${name}" upper)
        string(TOLOWER "${name}" lower)
        set(override "FETCHCONTENT_SOURCE_DIR_${upper}")
        if(DEFINED ${override} AND NOT "${${override}}" STREQUAL "")
            set(expected "${${override}}")
        else()
            set(expected "${FETCHCONTENT_BASE_DIR}/${lower}-src")
        endif()
        file(REAL_PATH "${actual}" actual)
        file(REAL_PATH "${expected}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Pinned ${name} source escaped its configured directory: ${actual} != ${expected}")
        endif()
        file(APPEND "${output}" "${name}\t${actual}\n")
    endforeach()
    if(NOT TARGET SDL3::SDL3)
        message(FATAL_ERROR "Pinned SDL3 target is missing")
    endif()
    get_target_property(imported SDL3::SDL3 IMPORTED)
    get_target_property(kind SDL3::SDL3 TYPE)
    get_target_property(actual SDL3::SDL3 SOURCE_DIR)
    FetchContent_GetProperties(SDL SOURCE_DIR expected)
    file(REAL_PATH "${actual}" actual)
    file(REAL_PATH "${expected}" expected)
    if(imported OR NOT kind STREQUAL "STATIC_LIBRARY" OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "SDL3 must be the static target from its pinned source directory")
    endif()
    if(DEFINED PETARI_SDL3_REF)
        petari_record_pad_dependencies("${output}")
    endif()
endfunction()

function(petari_record_pad_dependencies output)
    FetchContent_GetProperties(SDL SOURCE_DIR expected BINARY_DIR _sdl_binary)
    FetchContent_GetProperties(aurora SOURCE_DIR _aurora)
    # Check both Aurora's declared default and its effective cache value.
    # A changed upstream pin must never silently use our older SDL tree.
    file(STRINGS "${_aurora}/cmake/AuroraDependencyVersions.cmake" _sdl_ref_line
        REGEX "^_aurora_dependency_version\\(AURORA_SDL3_REF ")
    if(NOT _sdl_ref_line MATCHES "AURORA_SDL3_REF \"${PETARI_SDL3_REF}\" "
            OR NOT AURORA_SDL3_REF STREQUAL PETARI_SDL3_REF)
        message(FATAL_ERROR "Petari SDL pin differs from Aurora's AURORA_SDL3_REF")
    endif()
    if(NOT LibUSB_LIBRARY STREQUAL PETARI_LIBUSB_LIBRARY
            OR NOT EXISTS "${PETARI_LIBUSB_LIBRARY}"
            OR NOT SDL_HIDAPI_LIBUSB OR NOT SDL_HIDAPI_LIBUSB_SHARED)
        message(FATAL_ERROR "SDL must dynamically load the bundled libusb")
    endif()
    # Options express intent; the generated headers prove SDL actually found libusb and selected dynamic
    # loading instead of silently disabling it. They exist only after generation, so check them in the build.
    if(NOT TARGET SDL3-static)
        message(FATAL_ERROR "Pinned SDL3 static target is missing")
    endif()
    if(NOT TARGET petari_sdl_libusb_config_check)
        add_custom_target(petari_sdl_libusb_config_check
            COMMAND "${CMAKE_COMMAND}" "-DSDL_BINARY_DIR=${_sdl_binary}"
                -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CheckSDLLibusbConfig.cmake"
            VERBATIM)
        add_dependencies(SDL3-static petari_sdl_libusb_config_check)
    endif()
    file(APPEND "${output}" "libusb\t${PETARI_LIBUSB_LIBRARY}\t${PETARI_LIBUSB_VERSION}\tSHA256=${PETARI_LIBUSB_SHA256}\n")
    foreach(_patch IN LISTS PETARI_SDL_PATCHES)
        get_filename_component(_name "${_patch}" NAME)
        file(SHA256 "${_patch}" _hash)
        set(_stamp "${expected}/.petari-patches/${_name}.sha256")
        if(NOT EXISTS "${_stamp}")
            message(FATAL_ERROR "SDL patch was not applied: ${_name}")
        endif()
        file(READ "${_stamp}" _applied_hash)
        if(NOT _applied_hash STREQUAL _hash)
            message(FATAL_ERROR "SDL patch hash differs: ${_name}")
        endif()
        file(APPEND "${output}" "SDL-patch\t${_name}\tSHA256=${_hash}\n")
    endforeach()
endfunction()

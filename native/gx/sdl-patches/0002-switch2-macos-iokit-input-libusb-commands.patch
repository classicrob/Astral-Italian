+// The HID interface was opened by the platform backend (for example IOHID on
+// macOS, where the OS owns the HID interface), so there is no libusb device
+// handle for the vendor specific interface that takes the commands. Open the
+// USB device ourselves: the first one with the right IDs whose command
+// interface we can claim (a controller another instance already claimed
+// fails to claim and is skipped).
+static bool OpenCommandInterface(SDL_DriverSwitch2_Context *ctx, SDL_HIDAPI_Device *device)
+{
+    libusb_device **devices = NULL;
+    ssize_t count;
+
+    if (ctx->libusb->init(&ctx->usb_context) < 0) {
+        ctx->usb_context = NULL;
+        return SDL_SetError("Couldn't initialize libusb");
+    }
+
+    count = ctx->libusb->get_device_list(ctx->usb_context, &devices);
+    for (ssize_t i = 0; i < count && !ctx->interface_claimed; ++i) {
+        struct libusb_device_descriptor desc;
+        libusb_device_handle *handle = NULL;
+        Uint8 interface_number, out_endpoint, in_endpoint;
+
+        if (ctx->libusb->get_device_descriptor(devices[i], &desc) < 0 ||
+            desc.idVendor != device->vendor_id ||
+            desc.idProduct != device->product_id) {
+            continue;
+        }
+        if (ctx->libusb->open(devices[i], &handle) < 0) {
+            SDL_LogDebug(SDL_LOG_CATEGORY_INPUT, "Switch 2: couldn't open the USB device: %s", SDL_GetError());
+            continue;
+        }
+        if (!FindBulkEndpoints(ctx->libusb, handle, &interface_number, &out_endpoint, &in_endpoint)) {
+            ctx->libusb->close(handle);
+            continue;
+        }
+        int res = ctx->libusb->claim_interface(handle, interface_number);
+        if (res < 0) {
+            SDL_LogDebug(SDL_LOG_CATEGORY_INPUT, "Switch 2: couldn't claim interface %d: %s", interface_number, ctx->libusb->error_name(res));
+            ctx->libusb->close(handle);
+            continue;
+        }
+        ctx->device_handle = handle;
+        ctx->owns_device_handle = true;
+        ctx->interface_number = interface_number;
+        ctx->out_endpoint = out_endpoint;
+        ctx->in_endpoint = in_endpoint;
+        ctx->interface_claimed = true;
+    }
+    ctx->libusb->free_device_list(devices, 1);
+
+    if (!ctx->interface_claimed) {
+        ctx->libusb->exit(ctx->usb_context);
+        ctx->usb_context = NULL;
+        return SDL_SetError("Couldn't open the Switch 2 controller's command interface with libusb");
+    }
+    return true;
+}

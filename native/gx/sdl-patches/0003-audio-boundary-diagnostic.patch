--- /dev/null
+++ b/include/SDL3/SDL_petari_audio_diag.h
@@ -0,0 +1,27 @@
+/* Petari-only diagnostic extension to pinned SDL release-3.4.10.
+ * Not an upstream SDL API. Configure before opening any audio device.
+ * No observer, TLS, clocks, or argument work on the disabled hot path.
+ */
+#ifndef SDL_petari_audio_diag_h_
+#define SDL_petari_audio_diag_h_
+#include <SDL3/SDL_stdinc.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef void (SDLCALL *SDL_PetariAudioObserver)(unsigned boundary, const void *object, Sint64 value);
+enum {
+    SDL_PETARI_AQ_ENTRY=17, SDL_PETARI_AQ_EXIT,
+    SDL_PETARI_DEVICE_LOCK_REQUEST, SDL_PETARI_DEVICE_LOCK_ACQUIRED, SDL_PETARI_DEVICE_LOCK_RELEASED,
+    SDL_PETARI_GET_BEGIN, SDL_PETARI_GET_LOCK_REQUEST, SDL_PETARI_GET_LOCK_ACQUIRED,
+    SDL_PETARI_FILL_ENTRY, SDL_PETARI_FILL_EXIT,
+    SDL_PETARI_CONVERT_BEGIN, SDL_PETARI_CONVERT_END, SDL_PETARI_GET_END,
+    SDL_PETARI_PUT_BEGIN, SDL_PETARI_PUT_LOCK_REQUEST, SDL_PETARI_PUT_LOCK_ACQUIRED,
+    SDL_PETARI_PUT_LOCK_RELEASED, SDL_PETARI_PUT_END, SDL_PETARI_AQ_FORMAT
+};
+/* buffers=0 preserves SDL's calculation; 6/18 is output-only, 256/44100 only.
+ * An override requires a non-null observer. No fallback on invalid requests. */
+extern bool SDL_PetariConfigureAudioDiagnostic(SDL_PetariAudioObserver observer, int buffers);
+#ifdef __cplusplus
+}
+#endif
+#endif
--- /dev/null
+++ b/src/audio/SDL_petari_audio_diag.h
@@ -0,0 +1,11 @@
+/* Petari-only default-off diagnostic; no dependency on Petari C++ or clocks. */
+#include <SDL3/SDL_petari_audio_diag.h>
+extern SDL_PetariAudioObserver SDL_petari_audio_observer;
+extern int SDL_petari_aq_buffers;
+static SDL_INLINE void SDL_PetariAudioBoundary(unsigned boundary, const void *object, Sint64 value)
+{
+    SDL_PetariAudioObserver observer = __atomic_load_n(&SDL_petari_audio_observer, __ATOMIC_ACQUIRE);
+    if (observer) {
+        observer(boundary, object, value);
+    }
+}

# SCRATCH ONLY. Compose after all production Aurora transformations.
foreach(_wm_kind GXDispList.cpp fifo.cpp command_processor.cpp)
    get_target_property(_wm_sources aurora_gx SOURCES)
    set(_wm_matches 0)
    foreach(_wm_source IN LISTS _wm_sources)
        get_filename_component(_wm_name "${_wm_source}" NAME)
        if(_wm_name STREQUAL "${_wm_kind}")
            math(EXPR _wm_matches "${_wm_matches} + 1")
            if(IS_ABSOLUTE "${_wm_source}")
                set(_wm_input "${_wm_source}")
            else()
                set(_wm_input "${aurora_SOURCE_DIR}/${_wm_source}")
            endif()
            set(_wm_output "${CMAKE_CURRENT_BINARY_DIR}/wm-diag/${_wm_kind}")
            execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/patch_wm_diag.py"
                "${_wm_input}" "${_wm_output}" "${_wm_kind}" COMMAND_ERROR_IS_FATAL ANY)
            list(REMOVE_ITEM _wm_sources "${_wm_source}")
            list(APPEND _wm_sources "${_wm_output}")
            set_property(TARGET aurora_gx PROPERTY SOURCES "${_wm_sources}")
            if(_wm_kind STREQUAL "GXDispList.cpp")
                set(_wm_quote "${aurora_SOURCE_DIR}/lib/dolphin/gx")
            else()
                set(_wm_quote "${aurora_SOURCE_DIR}/lib/gx")
            endif()
            set_source_files_properties("${_wm_output}" TARGET_DIRECTORY aurora_gx PROPERTIES
                COMPILE_OPTIONS "-iquote${_wm_quote};-iquote${aurora_SOURCE_DIR}/lib;-iquote${CMAKE_CURRENT_SOURCE_DIR}")
        endif()
    endforeach()
    if(NOT _wm_matches EQUAL 1)
        message(FATAL_ERROR "WM diagnostic expected one active ${_wm_kind}, found ${_wm_matches}")
    endif()
endforeach()
target_include_directories(aurora_gx PRIVATE "${CMAKE_SOURCE_DIR}/native/include")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/patch_wm_diag.py" "${CMAKE_SOURCE_DIR}/native/include/petari/wm_diag.hpp")
